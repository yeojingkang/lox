// Lambda arg
fun thrice(fn) {
  for (var i = 1; i <= 3; i = i + 1) {
    fn(i);
  }
}

thrice(fun (a) {
  print a;
});

// Mutated vars
print fun () {};

var x = 0;
var f = fun () { print x; };
f();
(fun () { print x; })();

x = 1;

f();
(fun () { print x; })();

// Reassigning lambdas
var ff = fun () { print "f1"; };
ff();
ff = fun () { print "f2"; };
ff();
